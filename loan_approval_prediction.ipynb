        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X,\n",
        "    y,\n",
        "    test_size=0.20,\n",
        "    random_state=RANDOM_STATE,\n",
        "    stratify=y,\n",
        ")\n",
        "\n",
        "split_summary = pd.DataFrame({\n",
        "    \"rows\": [len(X_train), len(X_test)],\n",
        "    \"approved_share\": [y_train.mean(), y_test.mean()],\n",
        "}, index=[\"train\", \"test\"])\n",
        "display(split_summary.style.format({\"approved_share\": \"{:.2%}\"}))"
