      "source": [
        "NUMERIC_FEATURES = [\"Income\", \"Credit_Score\", \"Loan_Amount\", \"DTI_Ratio\"]\n",
        "CATEGORICAL_FEATURES = [\"Employment_Status\"]\n",
        "FEATURES = NUMERIC_FEATURES + CATEGORICAL_FEATURES\n",
        "TARGET = \"Approval\"\n",
        "\n",
        "LABEL_MAP = {\"Rejected\": 0, \"Approved\": 1}\n",
        "CLASS_NAMES = [\"Rejected\", \"Approved\"]\n",
        "\n",
        "X = df[FEATURES].copy()\n",
        "y = df[TARGET].map(LABEL_MAP)\n",
        "assert y.notna().all(), \"Unexpected label in target column\"\n",
        "\n",
        "print(\"Feature matrix:\", X.shape, \"| Target:\", y.shape)\n",
        "class_share = df[TARGET].value_counts(normalize=True).reindex(CLASS_NAMES)\n",
        "display((class_share * 100).round(2).to_frame(\"percent\"))\n",
        "\n",
        "sns.countplot(data=df, x=TARGET, order=CLASS_NAMES)\n",
        "plt.title(\"Target distribution (imbalanced)\")\n",
        "plt.show()"
      ]
    },
