        "param_grid = {\n",
        "    \"model__n_estimators\": [200, 300],\n",
        "    \"model__max_depth\": [None, 10, 20],\n",
        "    \"model__min_samples_split\": [2, 10],\n",
        "    \"model__min_samples_leaf\": [1, 4],\n",
        "    \"model__class_weight\": [None, \"balanced\"],\n",
        "}\n",
        "\n",
        "rf_search = GridSearchCV(\n",
        "    estimator=make_rf_pipeline(n_jobs=1),   # parallelism is handled by the search\n",
        "    param_grid=param_grid,\n",
        "    scoring=\"f1\",\n",
        "    cv=cv,\n",
        "    n_jobs=-1,\n",
        "    refit=True,\n",
        ")\n",
        "rf_search.fit(X_train, y_train)\n",
        "\n",
        "print(\"Best parameters:\", rf_search.best_params_)\n",
        "print(f\"Best mean CV F1: {rf_search.best_score_:.4f}\")\n",
        "\n",
        "rf_model = rf_search.best_estimator_\n",
        "rf_model.set_params(model__n_jobs=-1)\n",
        "\n",
        "top_configs = (\n",
        "    pd.DataFrame(rf_search.cv_results_)\n",
        "    .sort_values(\"rank_test_score\")\n",
        "    .loc[:, [\"params\", \"mean_test_score\", \"std_test_score\", \"rank_test_score\"]]\n",
        "    .head(5)\n",
        ")\n",
        "display(top_configs)"
      ]
    },
