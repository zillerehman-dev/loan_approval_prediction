        "def find_dataset(filename=\"loan_data.csv\"):\n",
        "    for candidate in (Path(\"../data\") / filename, Path(\"data\") / filename, Path(filename)):\n",
        "        if candidate.exists():\n",
        "            return candidate\n",
        "    try:  # Google Colab fallback\n",
        "        from google.colab import files\n",
        "        print(f\"'{filename}' not found - please upload it.\")\n",
        "        files.upload()\n",
        "        return Path(filename)\n",
        "    except ImportError:\n",
        "        raise FileNotFoundError(f\"Could not find {filename}. Place it in the data/ folder.\")\n",
        "\n",
        "\n",
        "df = pd.read_csv(find_dataset())\n",
        "print(\"Shape:\", df.shape)"
      ]
