      "source": [
        "thresholds = np.round(np.arange(0.1, 0.91, 0.1), 2)\n",
        "threshold_frames = {}\n",
        "\n",
        "for name, model in trained_models.items():\n",
        "    oof_proba = cross_val_predict(clone(model), X_train, y_train, cv=cv, method=\"predict_proba\")[:, 1]\n",
        "    threshold_frames[name] = pd.DataFrame([\n",
        "        {\n",
        "            \"Threshold\": thr,\n",
        "            \"Precision\": precision_score(y_train, oof_proba >= thr, zero_division=0),\n",
        "            \"Recall\": recall_score(y_train, oof_proba >= thr, zero_division=0),\n",
        "            \"F1-Score\": f1_score(y_train, oof_proba >= thr, zero_division=0),\n",
        "        }\n",
        "        for thr in thresholds\n",
        "    ]).set_index(\"Threshold\")\n",
        "\n",
        "fig, axes = plt.subplots(1, 2, figsize=(12, 4), sharey=True)\n",
        "for ax, (name, frame) in zip(axes, threshold_frames.items()):\n",
        "    frame[[\"Precision\", \"Recall\", \"F1-Score\"]].plot(ax=ax, marker=\"o\")\n",
        "    ax.axvline(0.5, color=\"grey\", linestyle=\"--\", linewidth=1)\n",
        "    ax.set_title(f\"{name} (out-of-fold, training data)\")\n",
        "    ax.set_ylim(0, 1.05)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "for name, frame in threshold_frames.items():\n",
        "    print(name)\n",
        "    display(frame.style.format(\"{:.3f}\"))"
      ]
    },
    {
