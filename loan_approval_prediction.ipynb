              "      <th id=\"T_4f77f_level0_row3\" class=\"row_heading level0 row3\" >Random Forest (balanced)</th>\n",
              "      <td id=\"T_4f77f_row3_col0\" class=\"data row3 col0\" >99.56%</td>\n",
              "      <td id=\"T_4f77f_row3_col1\" class=\"data row3 col1\" >98.49%</td>\n",
              "      <td id=\"T_4f77f_row3_col2\" class=\"data row3 col2\" >98.82%</td>\n",
