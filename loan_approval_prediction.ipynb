      "source": [
        "def evaluate_model(name, model, X_eval, y_eval):\n",
        "    y_pred = model.predict(X_eval)\n",
        "    return {\n",
        "        \"Model\": name,\n",
        "        \"Accuracy\": accuracy_score(y_eval, y_pred),\n",
        "        \"Precision\": precision_score(y_eval, y_pred, zero_division=0),\n",
        "        \"Recall\": recall_score(y_eval, y_pred, zero_division=0),\n",
        "        \"F1-Score\": f1_score(y_eval, y_pred, zero_division=0),\n",
        "    }\n",
        "\n",
        "\n",
        "trained_models = {\"Logistic Regression\": logreg_model, \"Random Forest\": rf_model}\n",
        "majority_baseline = DummyClassifier(strategy=\"most_frequent\").fit(X_train, y_train)\n",
        "\n",
        "test_results = [evaluate_model(name, model, X_test, y_test) for name, model in trained_models.items()]\n",
        "baseline_result = evaluate_model(\"Majority-class baseline\", majority_baseline, X_test, y_test)\n",
        "\n",
        "for name, model in trained_models.items():\n",
        "    print(f\"=== {name}: classification report (test set) ===\")\n",
        "    print(classification_report(y_test, model.predict(X_test), target_names=CLASS_NAMES, digits=4))"
      ]
    },
